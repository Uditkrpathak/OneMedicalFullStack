PORT=5001
MONGO_URI=mongodb://localhost:27017/one_medical_identity
JWT_ACCESS_SECRET=onemedical_access_secret_change_in_prod
JWT_REFRESH_SECRET=onemedical_refresh_secret_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# Set to 'true' in development to log OTPs to console instead of sending SMS
OTP_DEV_MODE=true

# Freemium SMS OTP Providers (Pick one to activate live SMS)
# Option 1: Authkey.io (Free Sandbox / Trial Credits) -> https://authkey.io
AUTHKEY_API_KEY=e255dcc9294a420b

# Option 2: MojoAuth (Freemium SMS & Passwordless) -> https://mojoauth.com
MOJOAUTH_API_KEY=your_mojoauth_api_key_here

CLINICAL_SERVICE_URL=http://localhost:5003
